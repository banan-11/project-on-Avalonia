<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Photo.App"
             RequestedThemeVariant="Light">
             

    
    <Application.Resources>
        <!-- Цвет фона шапки окна -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#D2F6E7" />
        
        <!-- Акцентный цвет для главных кнопок -->
        <SolidColorBrush x:Key="AccentBrush" Color="#70B2AF" />
        
        <!-- Цвет предупреждений или ошибок (красноватый) -->
        <SolidColorBrush x:Key="LowStockBrush" Color="#FF8080" />
        
        <!-- Основной белый фон страницы -->
        <SolidColorBrush x:Key="NormalBrush" Color="#FFFFFF" />
    </Application.Resources>
   




    <Application.Styles>

        <FluentTheme />

         <!--  Стиль для всех окон  Calibri, размер 16, белый фон -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Calibri" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{StaticResource NormalBrush}" />
        </Style>

        <!-- Для всех кнопок: внутренний и внешний отступ -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <!-- Только для кнопок с Classes="accent": акцентный цвет -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Длинный текст переносится на новую строку, а не обрезается -->
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Только для TextBlock с Classes="heading": крупный жирный заголовок -->
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>




    </Application.Styles>



</Application>