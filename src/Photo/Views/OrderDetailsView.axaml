<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Photo.Views.OrderDetailsView"
             Tag="Детали заказа"
             Background="#F3F4F6">

    <Grid RowDefinitions="*,Auto">
        
        <!-- ОСНОВНАЯ КАРТОЧКА ЗАКАЗА -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="16" 
                    Margin="20" 
                    Padding="30"
                    MaxWidth="800"
                    HorizontalAlignment="Center"
                    BoxShadow="0 10 25 #10000000">
                
                <StackPanel Spacing="25">
                    
                    <!-- Заголовок -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📄" FontSize="28" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderText" Text="Бронирование № ..." 
                                   FontSize="24" FontWeight="Bold" Foreground="#111827"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Height="1" Background="#E5E7EB" />

                    <!-- Сетка с информацией -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                          ColumnDefinitions="140,*" 
                          RowSpacing="12">
                        
                        <!-- Клиент -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="👤 Клиент:" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ClientText" Foreground="#111827" FontWeight="Medium"/>

                        <!-- Зал -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="🏠 Зал:" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HallText" Foreground="#111827" FontWeight="Medium"/>

                        <!-- Фотограф -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="📷 Фотограф:" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PhotographerText" Foreground="#111827" FontWeight="Medium"/>

                        <!-- Дата -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="📅 Дата:" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DateText" Foreground="#111827" FontWeight="Medium"/>

                        <!-- Время -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="⏰ Время:" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TimeText" Foreground="#111827" FontWeight="Medium"/>

                        <!-- Статус -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="🚦 Статус:" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <Border Grid.Row="5" Grid.Column="1" 
                                Background="#ECFDF5" CornerRadius="4" Padding="8,2" 
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="StatusText" Text="Статус" Foreground="#059669" FontWeight="Bold" FontSize="12"/>
                        </Border>

                        <!-- Итого -->
                        <Border Grid.Row="6" Grid.ColumnSpan="2" 
                                Background="#F9FAFB" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Итого к оплате:" FontWeight="Bold" FontSize="16" Foreground="#374151"/>
                                <TextBlock Grid.Column="1" x:Name="TotalText" Text="0 руб." 
                                           FontWeight="Bold" FontSize="20" Foreground="#2563EB"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="❌ Отменить бронь" 
                        Click="CancelOrderClick" 
                        Background="#FEE2E2" Foreground="#DC2626" 
                        CornerRadius="8" Padding="16,8" FontWeight="SemiBold"/>
                
                <Button Content="← Назад к списку" 
                        Click="GoBackClick" 
                        Background="#F3F4F6" Foreground="#374151"
                        CornerRadius="8" Padding="16,8" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- МОДАЛЬНОЕ ОКНО ПОДТВЕРЖДЕНИЯ (Поверх всего) -->
        <Border Grid.RowSpan="2" 
                Background="#80000000" 
                IsVisible="False" 
                x:Name="ConfirmPanel">
            
            <Border MaxWidth="400" 
                    Background="White" 
                    Padding="25" 
                    CornerRadius="12"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BoxShadow="0 20 25 #40000000">
                
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚠️" FontSize="24"/>
                        <TextBlock Text="Подтверждение отмены" FontWeight="Bold" FontSize="18" Foreground="#111827"/>
                    </StackPanel>
                    
                    <TextBlock Text="Вы уверены, что хотите отменить это бронирование? Это действие нельзя будет отменить, а слот освободится для других клиентов." 
                               TextWrapping="Wrap" Foreground="#4B5563" LineHeight="20"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Нет, оставить" 
                                Click="CancelDeleteClick"
                                Background="#F3F4F6" Foreground="#374151"
                                CornerRadius="6" Padding="12,6"/>
                        
                        <Button Content="Да, отменить" 
                                Click="ConfirmDeleteClick" 
                                Background="#DC2626" Foreground="White"
                                CornerRadius="6" Padding="12,6" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        
    </Grid>
</UserControl>