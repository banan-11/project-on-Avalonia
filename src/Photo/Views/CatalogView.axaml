<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Photo.Views.CatalogView"
             Tag="Каталог фотостудий">

    <DockPanel Background="#F5F7FA">
        
        <!-- ВЕРХНЯЯ ПАНЕЛЬ: Поиск и Фильтры -->
        <StackPanel DockPanel.Dock="Top" Spacing="15" Margin="20,20,20,10">
            
            <TextBlock Text="Фотостудии Санкт-Петербурга" 
                       FontSize="28" FontWeight="Bold" Foreground="#333"/>
            
            <!-- Строка поиска и сортировки -->
            <Grid ColumnDefinitions="*,200,Auto" RowDefinitions="Auto" Margin="0,10,0,0">
                <TextBox Grid.Column="0" 
                         x:Name="SearchBox" 
                         PlaceholderText="Поиск по названию студии..." 
                         TextChanged="SearchChanged"
                         CornerRadius="8"
                         Padding="10,8"/>
                
                <ComboBox Grid.Column="1" 
                          x:Name="SortBox" 
                          HorizontalAlignment="Stretch"
                          SelectionChanged="FilterChanged"
                          CornerRadius="8"
                          Margin="10,0,0,0">
                    <ComboBoxItem Content="Цена: по возрастанию" />
                    <ComboBoxItem Content="Цена: по убыванию" /> 
                </ComboBox>
                
                <Button Grid.Column="2" 
                        Content="Обновить" 
                        Click="ReloadClick" 
                        Margin="10,0,0,0"
                        CornerRadius="8"
                        Classes="accent"/>
            </Grid>
            
            <TextBlock x:Name="CountText" Foreground="#888" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ОСНОВНАЯ ОБЛАСТЬ: Сетка карточек -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <!-- ItemsControl вместо ListBox для гибкой сетки -->
            <ItemsControl x:Name="CardsList" Margin="20,0,20,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- WrapPanel позволяет элементам переноситься на новую строку -->
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- КАРТОЧКА ЗАЛА -->
                        <!-- PointerPressed заменяет SelectionChanged для ItemsControl -->
                        <Border Background="White" 
                                CornerRadius="12" 
                                Margin="10" 
                                Width="280"
                                BoxShadow="0 4 12 #20000000"
                                ClipToBounds="True"
                                Cursor="Hand"
                                PointerPressed="Card_PointerPressed"
                                Tag="{Binding}">
                            
                            <Grid RowDefinitions="180,Auto">
                                
                                <!-- 1. Изображение (верхняя часть) -->
                                <Image Grid.Row="0" 
                                       Source="{Binding Image}" 
                                       Stretch="UniformToFill" 
                                       Height="180"
                                       Width="280"/>
                                
                                <!-- 2. Информация (нижняя часть) -->
                                <!-- ИСПРАВЛЕНИЕ: StackPanel не имеет Padding. Используем Border как обертку -->
                                <Border Grid.Row="1" Padding="15" Background="White">
                                    <StackPanel Spacing="8">
                                        
                                        <!-- Название -->
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="Bold" 
                                                   FontSize="16" 
                                                   Foreground="#222"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"/>
                                        
                                        <!-- Описание / Оборудование (кратко) -->
                                        <TextBlock Text="{Binding Description}" 
                                                   Foreground="#666" 
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"/>
                                        
                                        <!-- Цена и Кнопка -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriceText}" 
                                                           FontWeight="Bold" 
                                                           FontSize="18" 
                                                           Foreground="#E67E22"/> 
                                                <TextBlock Text="за час" FontSize="10" Foreground="#999"/>
                                            </StackPanel>
                                            
                                            <!-- Визуальная кнопка -->
                                            <Border Grid.Column="1" 
                                                    Background="#FFC107" 
                                                    CornerRadius="6" 
                                                    Padding="12,6"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Выбрать" Foreground="Black" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
    </DockPanel>
</UserControl>