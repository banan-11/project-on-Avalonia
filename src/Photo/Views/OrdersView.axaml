<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Photo.Views.OrdersView"
             Tag="Список заказов">
  

      <DockPanel>
     <StackPanel DockPanel.Dock="Top" Spacing="10">
         <TextBlock Classes="heading" Text="Список заказов" />
         <StackPanel Orientation="Horizontal">
             <Button Content="Состав заказа" Classes="accent" Click="OpenClick" />
             <Button Content="Новый заказ" Click="NewClick" />
             <Button Content="Обновить" Click="ReloadClick" />
         </StackPanel>
     </StackPanel>
     <!-- Каждый заказ показывается текстом из Order.ToString() (файл ModelExtras.cs). -->
     <ListBox x:Name="OrdersList" />
 </DockPanel>













</UserControl>
