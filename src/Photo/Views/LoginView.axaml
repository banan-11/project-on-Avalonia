<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Photo.Views.LoginView"
             Tag="Вход">

    <!-- Центрируем форму по всему окну -->
    <Grid RowDefinitions="*,Auto,*">
        
        <!-- Верхняя пустая зона для центрирования -->
        <Border Grid.Row="0"/>

        <!-- САМА ФОРМА ВХОДА -->
        <StackPanel Grid.Row="1" 
                    Spacing="16" 
                    MaxWidth="400" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            
            <TextBlock Classes="heading" Text="Авторизация" HorizontalAlignment="Center"/>
            
            <!-- Поле Логина -->
            <TextBox x:Name="LoginBox" PlaceholderText="Логин (например, admin)" Watermark="Логин"/>
            
            <!-- Поле Пароля -->
            <TextBox x:Name="PasswordBox" PlaceholderText="Пароль" PasswordChar="*" Watermark="Пароль"/>
            
            <!-- Кнопка Войти -->
            <Button Content="Войти" Classes="accent" Click="LoginClick" HorizontalAlignment="Stretch"/>
            
            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="StatusText" Foreground="DarkRed" HorizontalAlignment="Center" TextWrapping="Wrap"/>

            <!-- Ссылка на регистрацию -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0,10,0,0">
                <TextBlock Text="Нет аккаунта?" Opacity="0.7"/>
                <Button Content="Зарегистрироваться" 
                        Click="GoToRegisterClick" 
                        Padding="0" 
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Нижняя пустая зона для центрирования -->
        <Border Grid.Row="2"/>
        
    </Grid>
</UserControl>